# Required for live news. Create a key at https://newsapi.org/
NEWSAPI_KEY=

# Local MongoDB defaults; replace with your own connection in production.
MONGODB_URI=mongodb://localhost:27017/newspeak
MONGODB_DATABASE=newspeak

# Optional development-only demo accounts. Keep disabled unless all three
# passwords are set to unique values of at least 12 characters.
DEMO_USERS_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
DEMO_WRITER_PASSWORD=
